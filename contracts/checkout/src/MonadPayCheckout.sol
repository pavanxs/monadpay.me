pragma solidity ^0.8.24;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/// @title MonadPayCheckout
/// @notice A merchant creates an invoice, a customer pays in the configured ERC-20,
///         and the merchant receives the tokens directly. A completed invoice
///         cannot be paid again. Onchain events and storage provide proof.
contract MonadPayCheckout is ReentrancyGuard {
    using SafeERC20 for IERC20;

    error InvalidSettlementToken();
    error InvalidInvoiceId();
    error InvalidAmount();
    error InvalidExpiry();
    error InvoiceAlreadyExists();
    error InvoiceDoesNotExist();
    error InvoiceAlreadyPaid();
    error InvoiceExpired();

    struct Invoice {
        address merchant;
        uint256 amount;
        uint64 expiresAt;
        address payer;
        uint64 paidAt;
    }

    IERC20 public immutable settlementToken;
    mapping(bytes32 => Invoice) public invoices;

    event InvoiceCreated(
        bytes32 indexed invoiceId,
        address indexed merchant,
        uint256 amount,
        uint64 expiresAt
    );

    event InvoicePaid(
        bytes32 indexed invoiceId,
        address indexed payer,
        address indexed merchant,
        uint256 amount,
        uint64 paidAt
    );

    constructor(IERC20 settlementToken_) {
        if (address(settlementToken_) == address(0)) revert InvalidSettlementToken();
        settlementToken = settlementToken_;
    }

    /// @notice The caller is the merchant. Invoice IDs must be unique globally.
    /// @param invoiceId Unique identifier generated by the merchant's application.
    /// @param amount Exact settlement-token amount in the token's smallest units.
    /// @param expiresAt Unix timestamp after which the invoice cannot be paid.
    function createInvoice(
        bytes32 invoiceId,
        uint256 amount,
        uint64 expiresAt
    ) external {
        if (invoiceId == bytes32(0)) revert InvalidInvoiceId();
        if (amount == 0) revert InvalidAmount();
        if (expiresAt <= block.timestamp) revert InvalidExpiry();
        if (invoices[invoiceId].merchant != address(0)) revert InvoiceAlreadyExists();

        invoices[invoiceId] = Invoice({
            merchant: msg.sender,
            amount: amount,
            expiresAt: expiresAt,
            payer: address(0),
            paidAt: 0
        });

        emit InvoiceCreated(invoiceId, msg.sender, amount, expiresAt);
    }

    /// @notice Pay the exact invoice amount, directly to the merchant.
    /// @dev Customer must first approve the checkout contract for this amount.
    ///      If the token transfer fails, all state updates revert atomically.
    function payInvoice(bytes32 invoiceId) external nonReentrant {
        Invoice storage invoice = invoices[invoiceId];
        if (invoice.merchant == address(0)) revert InvoiceDoesNotExist();
        if (invoice.payer != address(0)) revert InvoiceAlreadyPaid();
        if (block.timestamp > invoice.expiresAt) revert InvoiceExpired();

        // Mark as paid before calling an external token contract.
        invoice.payer = msg.sender;
        invoice.paidAt = uint64(block.timestamp);

        // Funds move straight from customer to merchant. This contract does not
        // retain customer funds or claim to convert assets or chains.
        settlementToken.safeTransferFrom(msg.sender, invoice.merchant, invoice.amount);

        emit InvoicePaid(
            invoiceId,
            msg.sender,
            invoice.merchant,
            invoice.amount,
            invoice.paidAt
        );
    }
}
